# Copy to .env at the project root. Never commit real credentials.
DATABASE_URL=postgresql://schengen:replace-me@127.0.0.1:55439/schengen
# Isolated test data only; never point tests at the development knowledge bank.
TEST_DATABASE_URL=postgresql://schengen:replace-me@127.0.0.1:55439/schengen_test

# For the optional Docker Compose setup; match the password in both URLs.
POSTGRES_PASSWORD=replace-me

# Optional local extraction suggestions; manual review works without a model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Dedicated embedding model; Qwen still generates answers.
OLLAMA_EMBED_MODEL=embeddinggemma
